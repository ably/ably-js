{
  "include": ["./src/**/*.ts"],
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "rootDir": "./src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "ably": ["../../../ably.d.ts"],
      "ably/liveobjects": ["../../../liveobjects.d.ts"]
    }
  }
}
